# Lokalnie: te same wartości co POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB w .env bazy (docker-compose)
DATABASE_URL=postgresql+psycopg://inqhub:CHANGE_ME@localhost:5432/inqhub
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_MIN_LENGTH=8
# Adresy frontendu po przecinku
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
